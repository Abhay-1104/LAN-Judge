# ============================================================
# LocalJudge .gitignore  (place in project root)
# ============================================================

# ---- Dependencies ----
node_modules/

# ---- Build output (regenerated by `npm run build`) ----
frontend/dist/
dist/
dist-ssr/
build/

# ---- Secrets / environment ----
.env
.env.*
!.env.example

# ---- HTTPS certificate + PRIVATE KEY (auto-generated per machine) ----
certs/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# ---- Database (real users, password hashes, submissions, violations) ----
backend/localjudge.db
backend/localjudge.db-*
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# ---- User-uploaded content (keep folder, ignore files) ----
backend/uploads/testcases/*
!backend/uploads/testcases/.gitkeep
backend/uploads/avatars/*
!backend/uploads/avatars/.gitkeep
backend/uploads/images/*
!backend/uploads/images/.gitkeep

# ---- Judge runtime leftovers ----
localjudge-*/
*.exe
*.class
a.out

# ---- Local one-off / debug scripts ----
backend/setup_test_quiz.js
backend/reset_quiz_14.js

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- Backups / archives ----
*.zip
*.bak
*.backup
*.tmp

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor files ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
